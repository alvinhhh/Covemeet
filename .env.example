# Local development only. Run node scripts/bootstrap.mjs to generate secrets.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
SITE_ORIGIN=http://localhost:5173
# Optional separate portal origin for self-hosted installations.
# PORTAL_ORIGIN=https://control.example.com
EDITION=self-hosted
BRAND_NAME=Covemeet
# Self-hosted defaults; hosted customer meetings use their paid plan limits.
MEETING_PARTICIPANT_LIMIT=100
WEBINAR_PARTICIPANT_LIMIT=1010
# Starts when the host opens the meeting. 0 means no duration limit.
MEETING_DURATION_SECONDS=0
# Self-hosted host/controller absence grace; 30–1800 seconds. Hosted uses 300.
HOST_ABSENCE_GRACE_SECONDS=300
FREE_MAX_ACTIVE_ROOMS=1
# Ended meeting content retention; choose a period and preview before deleting.
# See docs/data-retention.md. Disabled does not delete any meeting content.
MEETING_DATA_RETENTION_DAYS=0
MEETING_DATA_RETENTION_MODE=disabled
DATABASE_URL=postgresql://meeting:__POSTGRES_PASSWORD__@127.0.0.1:55432/meeting
# Production requires PostgreSQL TLS with certificate and hostname verification.
# Optional PEM CA bundle for a private database CA; mount it read-only.
# DATABASE_CA_FILE=/run/secrets/postgres-ca.crt
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
SESSION_SECRET=__SESSION_SECRET__
CREATION_KEY=__CREATION_KEY__
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
LIVEKIT_NODE_IP=127.0.0.1
REDIS_PASSWORD=__REDIS_PASSWORD__
# Phone ingress is experimental and off until the isolated gateway is configured.
# Never expose /api/internal/ through the public edge. See docs/phone-sip-design.md.
PHONE_ENABLED=false
# Independent random machine credential; do not reuse CREATION_KEY or SESSION_SECRET.
PHONE_GATEWAY_KEY=
PHONE_TRUNK_ID=
PHONE_DIAL_IN_NUMBER=
PHONE_SIP_ADDRESS=
PHONE_MAX_CALLS=20
PHONE_LOBBY_SECONDS=300
PHONE_MAX_DURATION_SECONDS=7200
# Base64-encoded 32-byte encryption key. Back it up separately from recordings.
RECORDING_KEK=__RECORDING_KEK__
# Keep this ID for existing recordings. Retain older keys separately for backup recovery.
RECORDING_KEK_ID=operator-kek-v1
RECORDING_KEY_PROVIDER=local
RECORDING_ACTIVE_KEY_ID=operator-kek-v1
# Optional JSON map of key ID to base64 32-byte KEK, injected from a secret manager.
# RECORDING_LOCAL_KEYS={"operator-kek-v2":"..."}
# KMS uses the AWS SDK workload identity/default credential chain; never put credentials in source.
# RECORDING_KEY_PROVIDER=aws-kms
# RECORDING_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/...
# RECORDING_KMS_DECRYPT_KEY_ARNS=comma-separated retained immutable key ARNs
RECORDING_KMS_REGION=us-east-1
RECORDING_ENABLED=false
RECORDING_DIR=__RECORDING_DIR__
EGRESS_FILE_ROOT=/recordings
# Optional private object storage; local encrypted files remain the default.
RECORDING_STORAGE=local
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=us-east-1
RECORDING_S3_PREFIX=recordings
# HTTPS endpoint for S3-compatible providers; omit for AWS S3.
RECORDING_S3_ENDPOINT=
RECORDING_S3_PATH_STYLE=false
# HTTP is permitted only for explicitly enabled loopback IP endpoints outside production.
RECORDING_S3_ALLOW_LOCAL_HTTP=false
# 64 GiB maximum encrypted object size; multipart uploads remain memory-bounded.
RECORDING_MAX_BYTES=68719476736
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=meetings@localhost.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__

# Default SMTP supports local mail capture and operator-managed SMTP.
MAIL_TRANSPORT=smtp
# Twilio Email API uses its own key, not SendGrid SMTP credentials.
# Set MAIL_TRANSPORT=twilio-email and share MAIL_DATABASE_URL with the hosted app.
TWILIO_EMAIL_ACCOUNT_SID=
TWILIO_EMAIL_API_KEY_SID=
TWILIO_EMAIL_API_KEY_SECRET=
# For SES on EC2, set MAIL_TRANSPORT=ses and use a dedicated sending role.
# Leave AWS access keys/profiles unset. Both apps must share MAIL_DATABASE_URL.
SES_REGION=
SES_ACCOUNT_ID=
SES_ROLE_ARN=
SES_CONFIGURATION_SET=
AWS_EC2_METADATA_SERVICE_ENDPOINT=http://169.254.169.254
MAIL_DATABASE_URL=
MAIL_DATABASE_CA_FILE=
