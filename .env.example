# Local development only. Run node scripts/bootstrap.mjs to generate secrets.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
SITE_ORIGIN=http://localhost:5173
# Optional separate portal origin for self-hosted installations.
# PORTAL_ORIGIN=https://control.example.com
EDITION=self-hosted
BRAND_NAME=Covemeet
DATABASE_URL=postgresql://meeting:__POSTGRES_PASSWORD__@127.0.0.1:55432/meeting
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
SESSION_SECRET=__SESSION_SECRET__
CREATION_KEY=__CREATION_KEY__
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:4100
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
LIVEKIT_NODE_IP=127.0.0.1
REDIS_PASSWORD=__REDIS_PASSWORD__
# Base64-encoded 32-byte encryption key. Back it up separately from recordings.
RECORDING_KEK=__RECORDING_KEK__
# Keep this ID for existing recordings. Retain older keys separately for backup recovery.
RECORDING_KEK_ID=operator-kek-v1
RECORDING_KEY_PROVIDER=local
RECORDING_ACTIVE_KEY_ID=operator-kek-v1
# Optional JSON map of key ID to base64 32-byte KEK, injected from a secret manager.
# RECORDING_LOCAL_KEYS={"operator-kek-v2":"..."}
# KMS uses the AWS SDK workload identity/default credential chain; never put credentials in source.
# RECORDING_KEY_PROVIDER=aws-kms
# RECORDING_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/...
# RECORDING_KMS_DECRYPT_KEY_ARNS=comma-separated retained immutable key ARNs
RECORDING_KMS_REGION=us-east-1
RECORDING_ENABLED=false
RECORDING_DIR=__RECORDING_DIR__
EGRESS_FILE_ROOT=/recordings
# Optional private object storage; local encrypted files remain the default.
RECORDING_STORAGE=local
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=us-east-1
RECORDING_S3_PREFIX=recordings
# HTTPS endpoint for S3-compatible providers; omit for AWS S3.
RECORDING_S3_ENDPOINT=
RECORDING_S3_PATH_STYLE=false
# HTTP is permitted only for explicitly enabled loopback IP endpoints outside production.
RECORDING_S3_ALLOW_LOCAL_HTTP=false
# 64 GiB maximum encrypted object size; multipart uploads remain memory-bounded.
RECORDING_MAX_BYTES=68719476736
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=meetings@localhost.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__
