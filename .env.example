# Local development only. Run node scripts/bootstrap.mjs to generate secrets.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
SITE_ORIGIN=http://localhost:5173
# Optional separate portal origin for self-hosted installations.
# PORTAL_ORIGIN=https://control.example.com
EDITION=self-hosted
BRAND_NAME=Covemeet
DATABASE_URL=postgresql://meeting:__POSTGRES_PASSWORD__@127.0.0.1:55432/meeting
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
SESSION_SECRET=__SESSION_SECRET__
CREATION_KEY=__CREATION_KEY__
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:4100
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
LIVEKIT_NODE_IP=127.0.0.1
REDIS_PASSWORD=__REDIS_PASSWORD__
# Base64-encoded 32-byte encryption key. Back it up separately from recordings.
RECORDING_KEK=__RECORDING_KEK__
RECORDING_ENABLED=false
RECORDING_DIR=__RECORDING_DIR__
EGRESS_FILE_ROOT=/recordings
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=meetings@localhost.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
LOCAL_UID=__LOCAL_UID__
LOCAL_GID=__LOCAL_GID__
