{
  admin off
  persist_config off
  auto_https disable_redirects
  skip_install_trust
  # Local validation reports status separately. Request URLs and headers can contain capabilities.
  log {
    output discard
  }
  pki {
    ca local {
      name "Covemeet Local Development"
    }
  }
}

https://meet.localhost:8443 {
  tls internal {
    protocols tls1.3
  }
  respond /api/internal/* 404
  reverse_proxy core:4100 {
    header_up X-Forwarded-For {remote_host}
    header_up -Forwarded
  }
}

https://portal.localhost:8443 {
  tls internal {
    protocols tls1.3
  }
  respond /api/internal/* 404
  reverse_proxy {$PORTAL_UPSTREAM:core:4100} {
    header_up X-Forwarded-For {remote_host}
    header_up -Forwarded
  }
}
