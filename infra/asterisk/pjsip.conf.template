[global]
type=global
user_agent=Covemeet-local-fixture
endpoint_identifier_order=auth_username,username,ip
max_forwards=10

[tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
cert_file=/certs/asterisk.crt
priv_key_file=/certs/asterisk.key
ca_list_file=/certs/ca.crt
method=tlsv1_2
verify_server=yes
verify_client=no
require_client_cert=no
allow_reload=no

[syntheticclient-auth]
type=auth
auth_type=userpass
username=syntheticclient
password=__CLIENT_PASSWORD__

[syntheticclient]
type=endpoint
transport=tls
context=covemeet-inbound
auth=syntheticclient-auth
disallow=all
allow=ulaw
dtmf_mode=rfc4733
direct_media=no
media_encryption=sdes
media_encryption_optimistic=no
srtp_tag_32=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
allow_transfer=no
allow_subscribe=no
rtp_timeout=30
rtp_timeout_hold=60

[livekit-auth]
type=auth
auth_type=userpass
username=covemeet-pbx
password=__LIVEKIT_TRUNK_PASSWORD__

[covemeet-livekit]
type=endpoint
transport=tls
context=covemeet-reject
outbound_auth=livekit-auth
aors=covemeet-livekit-address
from_user=covemeet-pbx
from_domain=asterisk
disallow=all
allow=ulaw
dtmf_mode=rfc4733
direct_media=no
media_encryption=sdes
media_encryption_optimistic=no
srtp_tag_32=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
allow_transfer=no
allow_subscribe=no
rtp_timeout=30
rtp_timeout_hold=60

[covemeet-livekit-address]
type=aor
contact=sip:sip:5061;transport=tls
